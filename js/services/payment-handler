/**
 * Pena Administrasi Guru & Sekolah - Payment & Access Handler
 * Versi Multi-Step + Jalur Darurat Tersembunyi + Sinkronisasi AI Master Prompt (v3)
 */

const PaymentHandler = {
    // 1. CEK STATUS PREMIUM USER UNTUK AI MASTER PROMPT
    isPremium: function() {
        return localStorage.getItem('qris_verified') === 'true' || localStorage.getItem('pena_user_premium') === 'true';
    },

    isDocumentUnlocked: function(berkasId) {
        if (this.isPremium()) return true;
        return localStorage.getItem(`pena_unlock_${berkasId}`) === 'true';
    },

    // 2. AKTIFKAN AKSES DOKUMEN & LOKAL AKUN PREMIUM
    unlockDocumentPermanently: function(berkasId) {
        // Aktifkan kunci per dokumen
        localStorage.setItem(`pena_unlock_${berkasId}`, 'true');
        
        // SINKRONISASI AI HANDLER: Aktifkan status QRIS Verified untuk Master Prompt Premium
        localStorage.setItem('qris_verified', 'true');
        localStorage.setItem('pena_user_premium', 'true');
    },

    hitungKunciJawaban: function(angkaAcak) {
        return parseInt(angkaAcak) + 2026; 
    },

    tampilkanStepEmail: function() {
        const stepEmail = document.getElementById('wrapper-step-email');
        if (stepEmail) {
            stepEmail.classList.remove('hidden');
            stepEmail.scrollIntoView({ behavior: 'smooth' });
        }
    },

    kirimKeGoogleCloud: function(email, kunci, berkas) {
        const urlGoogleCloud = "https://script.google.com/macros/s/AKfycbwUD11hCbXRoIlLEmfxSI6yXjHI4RtjU96TPvZx9YA2wOadzGpKQw4qrxnWHtRnNTRBmw/exec";
        
        if (!email || email.trim() === "") {
            alert("⚠️ Alamat email wajib diisi!");
            return;
        }

        const emailInputArea = document.getElementById('email-input-area');
        if (emailInputArea) {
            emailInputArea.innerHTML = `<div class="text-amber-700 font-bold text-[11px] mt-1 animate-pulse">⏳ Memproses pengiriman kunci ke email...</div>`;
        }

        // Tembak URL Google Cloud
        fetch(`${urlGoogleCloud}?email=${encodeURIComponent(email.trim())}&key=${kunci}&berkas=${encodeURIComponent(berkas)}`, { mode: 'no-cors' })
        .then(() => {
            if (emailInputArea) {
                emailInputArea.innerHTML = `<div class="text-emerald-700 font-bold text-[11px] mt-1">✨ Kunci dikirim ke ${email.trim()}! Cek kotak masuk/spam.</div>`;
            }
            const stepKunci = document.getElementById('wrapper-step-kunci');
            if (stepKunci) {
                stepKunci.classList.remove('hidden');
                stepKunci.scrollIntoView({ behavior: 'smooth' });
            }
        })
        .catch(err => {
            console.error("Gagal menghubungi Google Server:", err);
            if (emailInputArea) {
                emailInputArea.innerHTML = `<div class="text-rose-600 font-bold text-[10px] mt-1">⚠️ Gagal mengirim otomatis. Silakan gunakan bantuan tiket di bawah.</div>`;
            }
            const stepKunci = document.getElementById('wrapper-step-kunci');
            if (stepKunci) stepKunci.classList.remove('hidden');
        });
    },

    // MEMUNCULKAN FORM PENGISIAN TIKET YANG TERSEMBUNYI
    bukaOpsiBantuanDarurat: function() {
        const areaDarurat = document.getElementById('kotak-jalur-darurat');
        const tombolBantuan = document.getElementById('btn-bantuan-darurat');
        if (areaDarurat) areaDarurat.classList.remove('hidden');
        if (tombolBantuan) tombolBantuan.classList.add('hidden'); // Sembunyikan tombol setelah diklik
    },

    klaimKunciDarurat: function(berkasId, angkaTiketAsli) {
        const inputTiket = document.getElementById('input-tiket-darurat').value.trim();
        const infoBox = document.getElementById('info-klaim-darurat');
        
        const cleanInput = inputTiket.replace(/\D/g, ''); 

        if (cleanInput === angkaTiketAsli.toString()) {
            const kunciJawabanAsli = this.hitungKunciJawaban(angkaTiketAsli);
            
            infoBox.className = "mt-2 p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-center animate-fade-in";
            infoBox.innerHTML = `
                <p class="text-emerald-800 font-bold text-[10px] mb-1">🎉 ID Tiket Cocok!</p>
                <button onclick="PaymentHandler.eksekusiKlaimLangsung('${berkasId}', ${kunciJawabanAsli})" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-1.5 rounded text-[11px] cursor-pointer">
                    🔓 Klik untuk Buka Berkas Sekarang
                </button>
            `;
        } else {
            alert("❌ ID Tiket tidak sesuai dengan sesi halaman ini. Periksa kembali angka yang Anda masukkan.");
        }
    },

    eksekusiKlaimLangsung: function(berkasId, kunci) {
        this.unlockDocumentPermanently(berkasId);
        alert("🎉 Berhasil! Akses Premium & Master Prompt AI Anda telah aktif.");
        const targetModal = document.getElementById('modal-qris-payment');
        if (targetModal) targetModal.remove();
        if (window.location.reload) window.location.reload();
    },

    triggerPaymentModal: function(paketId, namaBerkas, harga = "15.000") {
        const modalId = 'modal-qris-payment';
        let existingModal = document.getElementById(modalId);
        if (existingModal) existingModal.remove();

        const nomorWaAdmin = "6282181526078"; 
        const namaMerchantDana = "Tch_Web_adm_guru"; 

        const angkaTiket = Math.floor(1000 + Math.random() * 9000);
        const kunciJawabanAsli = this.hitungKunciJawaban(angkaTiket);
        
        const teksWa = encodeURIComponent(`Halo Admin, saya telah mentransfer kontribusi Rp ${harga} via QRIS untuk paket/berkas: ${namaBerkas}.\n\n(ID TIKET CADANGAN: PENA-${angkaTiket})`);
        const waLink = `https://wa.me/${nomorWaAdmin}?text=${teksWa}`;

        let gambarQris = "assets/img/qrcode/qris-eceran.png";
        
        switch(paketId) {
            case 'eceran':
                gambarQris = "assets/img/qrcode/qris-eceran.png";
                break;
            case 'premium-1-bulan':
                gambarQris = "assets/img/qrcode/qris-premium-1-bulan.png";
                break;
            case 'premium-3-bulan':
                gambarQris = "assets/img/qrcode/qris-premium-3-bulan.png";
                break;
            case 'premium-6-bulan':
                gambarQris = "assets/img/qrcode/qris-premium-6-bulan.png";
                break;
            case 'premium-12-bulan':
                gambarQris = "assets/img/qrcode/qris-premium-12-bulan.png";
                break;
        }

        const modalHtml = `
            <div id="${modalId}" class="fixed inset-0 bg-slate-950/70 backdrop-blur-sm flex items-center justify-center z-[9999] p-4 font-sans text-xs animate-fade-in">
                <div class="bg-white rounded-2xl max-w-sm w-full p-5 shadow-2xl border border-slate-200 text-center relative text-slate-800 max-h-[90vh] overflow-y-auto">
                    
                    <button onclick="document.getElementById('${modalId}').remove()" class="absolute top-3 right-4 text-slate-400 hover:text-slate-600 transition text-2xl font-semibold cursor-pointer">&times;</button>
                    
                    <span class="bg-blue-100 text-blue-800 font-bold px-3 py-0.5 rounded-full uppercase tracking-wider text-[10px]">Alur Validasi Terstruktur</span>
                    <h3 class="text-sm font-black mt-2 text-slate-900 leading-tight mb-3">Buka Akses: <span class="text-blue-600">${namaBerkas}</span></h3>
                    
                    <!-- STEP 1: SCAN QRIS -->
                    <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-left mb-3">
                        <p class="font-bold text-slate-900 mb-1">Step 1: Scan & Transfer QRIS</p>
                        <p class="text-slate-500 text-[10px] mb-2">Silakan lakukan pemindaian dan transfer kontribusi Rp ${harga} melalui aplikasi e-wallet atau m-banking Anda:</p>
                        <div class="text-center bg-white p-2 rounded border border-slate-200">
                            <img src="${gambarQris}" alt="QRIS ${namaMerchantDana}" class="w-36 h-36 mx-auto object-contain">
                            <p class="text-[10px] font-black text-slate-700 uppercase tracking-wide mt-1">${namaMerchantDana}</p>
                        </div>
                    </div>

                    <!-- STEP 2: KONFIRMASI WA -->
                    <div class="text-left bg-blue-50 border border-blue-200 rounded-xl p-3 mb-3">
                        <p class="font-bold text-blue-900 mb-1">Step 2: Konfirmasi via WhatsApp</p>
                        <p class="text-slate-600 text-[11px] mb-2">Setelah berhasil transfer, wajib klik tombol di bawah untuk lapor ke WhatsApp Admin:</p>
                        <a href="${waLink}" target="_blank" onclick="PaymentHandler.tampilkanStepEmail()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 px-3 rounded-lg flex items-center justify-center gap-1.5 transition-all text-[11px] decoration-none shadow-sm cursor-pointer">
                            💬 Kirim Laporan & Lanjut Step 3
                        </a>
                    </div>

                    <!-- STEP 3: INPUT EMAIL -->
                    <div id="wrapper-step-email" class="text-left bg-amber-50 border border-amber-200 rounded-xl p-3 mb-3 hidden transition-all duration-300">
                        <p class="font-bold text-amber-900 mb-1">Step 3: Masukkan Email Penerima Kode</p>
                        <p class="text-slate-600 text-[10px] mb-2">Tulis email Anda yang aktif untuk menerima 4 digit kode kunci secara otomatis dari Google Cloud:</p>
                        <div id="email-input-area" class="flex gap-1.5">
                            <input type="email" id="email-guru-input" placeholder="Contoh: guru@gmail.com" class="w-2/3 p-1.5 border border-amber-300 rounded bg-white text-slate-800 focus:outline-none text-[11px]">
                            <button onclick="PaymentHandler.kirimKeGoogleCloud(document.getElementById('email-guru-input').value, ${kunciJawabanAsli}, '${namaBerkas}')" class="w-1/3 bg-amber-600 hover:bg-amber-700 text-white font-bold rounded text-[10px] cursor-pointer">Kirim Kunci</button>
                        </div>
                    </div>

                    <!-- STEP 4: MASUKKAN KODE VERIFIKASI -->
                    <div id="wrapper-step-kunci" class="text-left bg-slate-50 border border-slate-200 rounded-xl p-3 hidden transition-all duration-300">
                        <p class="font-bold text-slate-900 mb-1">Step 4: Masukkan Kode Verifikasi</p>
                        <p class="text-slate-500 text-[10px] mb-2">Buka email Anda, lalu ketikkan 4 digit kode kunci yang diterima ke kolom berikut:</p>
                        
                        <div class="flex gap-2 mb-2">
                            <input type="number" id="input-kunci-akses" placeholder="Contoh: 7492" class="w-1/2 p-2 border border-slate-300 rounded-lg text-center font-mono font-bold text-sm bg-white text-slate-800 focus:ring-2 focus:ring-blue-500 focus:outline-none">
                            <button onclick="PaymentHandler.validateUserCode('${paketId}', ${angkaTiket})" class="w-1/2 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-lg transition-all text-[11px] cursor-pointer">
                                🔑 Validasi Kunci
                            </button>
                        </div>

                        <!-- TOMBOL BANTUAN -->
                        <div class="text-center py-1 font-medium">
                            <button id="btn-bantuan-darurat" onclick="PaymentHandler.bukaOpsiBantuanDarurat()" class="text-[9px] text-slate-400 hover:text-blue-600 transition underline decoration-dotted cursor-pointer bg-transparent border-none">
                                ⚠️ Mengalami masalah pengiriman email? Klik bantuan tiket
                            </button>
                        </div>

                        <!-- FORM TIKET DARURAT -->
                        <div id="kotak-jalur-darurat" class="hidden border-t border-dashed border-slate-300 pt-2.5 mt-2 bg-red-50/50 p-2 rounded-lg animate-fade-in">
                            <p class="text-red-900 font-bold text-[10px] mb-1">Jalur Akses Darurat Otomatis</p>
                            <p class="text-slate-500 text-[9px] mb-1.5">Sesuai instruksi Bot WA, masukkan kembali 4 digit angka ID Tiket Anda (<span class="text-blue-600 font-bold font-mono">PENA-${angkaTiket}</span>) di bawah ini:</p>
                            <div class="flex gap-1.5">
                                <input type="text" id="input-tiket-darurat" placeholder="Ketik ${angkaTiket}" class="w-2/3 p-1.5 border border-slate-300 rounded bg-white text-slate-800 focus:outline-none text-center text-[11px] font-mono">
                                <button onclick="PaymentHandler.klaimKunciDarurat('${paketId}', ${angkaTiket})" class="w-1/3 bg-slate-800 hover:bg-slate-900 text-white font-bold rounded text-[9px] cursor-pointer">Klaim Akses</button>
                            </div>
                            <div id="info-klaim-darurat"></div>
                        </div>
                    </div>

                </div>
            </div>
        `;

        document.body.insertAdjacentHTML('beforeend', modalHtml);
    },

    validateUserCode: function(berkasId, angkaTiket) {
        const inputField = document.getElementById('input-kunci-akses');
        const userKunci = parseInt(inputField.value);
        const kunciJawabanAsli = this.hitungKunciJawaban(angkaTiket);

        if (userKunci === kunciJawabanAsli) {
            this.unlockDocumentPermanently(berkasId);
            alert("🎉 Selamat! Kunci akses cocok. Akses Premium & Master Prompt AI Anda telah terbuka.");
            
            const targetModal = document.getElementById('modal-qris-payment');
            if (targetModal) targetModal.remove();
            
            if (window.location.reload) window.location.reload();
        } else {
            alert("❌ Kode verifikasi salah. Silakan periksa angka murni yang dikirim ke email Anda.");
            inputField.value = '';
            inputField.focus();
        }
    }
};

Object.freeze(PaymentHandler);
